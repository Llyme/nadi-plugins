{
  "id": "battery",
  "name": "Battery",
  "description": "How full the battery is, as a liquid that fills a vessel: a tile, a card, three widgets, and a banner when it runs low, is plugged in, or is full.",
  "version": "1.0.0",
  "kind": "wasm",
  "module": "battery.wasm",
  "tile": { "name": "Battery", "icon": "battery", "tint": "#5ac88c", "sizes": ["small", "wide", "large"], "idle": "No battery", "look": "vessel" },
  "default_on": false,
  "banners": true,
  "permissions": { "battery": true },
  "source": { "when": "always" },
  "settings": {
    "alerts": { "label": "Banners when the battery changes", "type": "toggle", "default": true },
    "b_low": { "label": "Banner: low", "type": "toggle", "default": true },
    "b_critical": { "label": "Banner: critical", "type": "toggle", "default": true },
    "b_plugged": { "label": "Banner: plugged in", "type": "toggle", "default": true },
    "b_unplugged": { "label": "Banner: unplugged", "type": "toggle", "default": false },
    "b_full": { "label": "Banner: full", "type": "toggle", "default": true },
    "b_saver": { "label": "Banner: battery saver", "type": "toggle", "default": false },
    "b_health": { "label": "Banner: wearing out", "type": "toggle", "default": false },
    "low": { "label": "Low mark", "type": "range", "min": 10, "max": 50, "step": 1, "unit": "%", "default": 20 },
    "critical": { "label": "Critical mark", "type": "range", "min": 3, "max": 20, "step": 1, "unit": "%", "default": 10 }
  },
  "widgets": [
    { "id": "battery", "name": "Battery", "place": "right", "rank": 45, "width": 110, "start": false },
    { "id": "circle", "name": "Battery circle", "place": "right", "rank": 46, "width": 62, "start": false },
    { "id": "charge", "name": "Charge", "place": "right", "rank": 47, "width": 150, "start": false }
  ]
}
