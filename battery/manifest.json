{
  "id": "battery",
  "name": "Battery",
  "description": "How full the battery is, as a liquid that fills a vessel, and a banner when it runs low, is plugged in, or is full.",
  "version": "2.4.0",
  "kind": "luau",
  "default_on": false,
  "banners": true,
  "permissions": {
    "battery": true
  },
  "source": {
    "when": "always"
  },
  "settings": {
    "alerts": {
      "label": "Banners when the battery changes",
      "type": "toggle",
      "default": true
    },
    "b_low": {
      "label": "Banner: low",
      "type": "toggle",
      "default": true
    },
    "b_critical": {
      "label": "Banner: critical",
      "type": "toggle",
      "default": true
    },
    "b_plugged": {
      "label": "Banner: plugged in",
      "type": "toggle",
      "default": true
    },
    "b_unplugged": {
      "label": "Banner: unplugged",
      "type": "toggle",
      "default": false
    },
    "b_full": {
      "label": "Banner: full",
      "type": "toggle",
      "default": true
    },
    "b_saver": {
      "label": "Banner: battery saver",
      "type": "toggle",
      "default": false
    },
    "b_health": {
      "label": "Banner: wearing out",
      "type": "toggle",
      "default": false
    },
    "low": {
      "label": "Low mark",
      "type": "range",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    "critical": {
      "label": "Critical mark",
      "type": "range",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 10
    }
  },
  "widgets": [
    {
      "id": "battery",
      "name": "Battery",
      "description": "The battery as a liquid, the number beside it.",
      "place": "right",
      "rank": 30
    }
  ],
  "main": "main.luau"
}
