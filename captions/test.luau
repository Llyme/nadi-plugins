tests = {}

function tests.it_hears_speech_and_shows_the_last_line()
	local s = handle({ event = "start", now = 0, settings = {} })
	eq(s.subscribe, { "speech.line", "speech.draft", "speech.drop", "speech.status", "speech.revised" }, "it hears speech")
	local o = handle({ event = "speech.line", now = 1, settings = {}, text = "ship it", name = "Kai", speaker = "s1", avatar = "🦊" })
	eq(o.widgets.live.peek, { icon = "chat" }, "at rest: a pictogram, the words are the banner's")
	eq(o.widgets.live.panel.body[2].items[1].avatar, "🦊", "opened: a script, with their animal")
	local d = handle({ event = "speech.draft", now = 2, settings = {}, text = "and then we", name = "Kai", source = "system" })
	eq(d.say[1].text, "and then we", "what is being said: the banner")
	local l = handle({ event = "speech.status", now = 2, settings = {}, state = "listening" })
	eq(l.widgets.live.peek.text, "🦊", "listening: who spoke last")
	eq(o.say[1].title, "Kai", "someone talking: a banner")
	local q = handle({ event = "speech.draft", now = 2500, settings = {}, text = "and then we went", name = "Kai", source = "system" })
	eq(q.say[1].text, "and then we went", "the banner follows their words")
	eq(q.say[1].pill.live, true, "live: there while they talk")
	local off = handle({ event = "speech.draft", now = 2600, settings = { banner = false }, text = "and", name = "Kai", source = "system" })
	eq(off.say, nil, "switched off: no banner")
	local r = handle({ event = "speech.revised", now = 3000, settings = {}, lines = {} })
	check(r.widgets.live ~= nil, "a revision redraws")
	local t = handle({ event = "action", now = 2, settings = {}, action = "toggle" })
	eq(t.call, { service = "speech", what = "toggle" }, "pressed: speech listens")
	local m = handle({ event = "action", now = 3, settings = {}, action = "src:mic" })
	eq(m.call, { service = "speech", what = "sources", args = { mic = false, system = true } }, "the microphone off")
end
