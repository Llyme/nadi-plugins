{
  "id": "claude",
  "name": "Claude",
  "description": "Your Claude Code sessions as cards, a pill when one needs you or has finished, and how much of your Claude 5-hour and 7-day limits you have used.",
  "version": "3.1.0",
  "kind": "bundle",
  "tile": {"name": "Claude", "icon": "sparkle", "tint": "#e8963c", "sizes": ["small", "wide"], "idle": "all quiet"},
  "replaces": [
    "claude-code",
    "claude-usage"
  ],
  "default_on": false,
  "banners": true,
  "settings": {
    "alerts": {
      "label": "Pill when a session needs me or finishes",
      "type": "toggle",
      "default": true
    },
    "usage": {
      "label": "Show how much of my limits is used",
      "type": "toggle",
      "default": true
    }
  },
  "actions": [
    {
      "part": "usage",
      "id": "usage_login",
      "label": "Sign In",
      "ask": "Paste the code the Claude page shows",
      "then": "usage_finish"
    }
  ],
  "widgets": [
    {
      "part": "sessions",
      "id": "needs",
      "name": "Needs you",
      "place": "left",
      "rank": 39,
      "width": 90,
      "start": false
    },
    {
      "part": "usage",
      "id": "bars",
      "name": "Bars",
      "place": "right",
      "rank": 40,
      "width": 68
    },
    {
      "part": "usage",
      "id": "rings",
      "name": "Circles",
      "place": "right",
      "rank": 42,
      "width": 64,
      "start": false
    }
  ],
  "parts": [
    {
      "id": "sessions",
      "module": "sessions.wasm",
      "crate": "claude-code",
      "permissions": {
        "claude": true,
        "processes": true,
        "titles": true,
        "programs": true
      }
    },
    {
      "id": "usage",
      "module": "usage.wasm",
      "crate": "claude-usage",
      "tick": "5s",
      "permissions": {
        "net": [
          "api.anthropic.com",
          "console.anthropic.com"
        ],
        "open": [
          "https://claude.ai/oauth/authorize"
        ],
        "storage": true
      }
    }
  ],
  "rests": [
    {
      "id": "needs",
      "name": "Claude",
      "description": "Which session needs you, and how much of your limits is used.",
      "when": "While a session needs you",
      "priority": 70,
      "left": "claude-sessions:needs",
      "center": "eyes:head",
      "right": "claude-usage:bars"
    }
  ]
}
