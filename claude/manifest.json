{
  "id": "claude",
  "name": "Claude",
  "description": "Your Claude Code sessions for as long as they run (and the Claude desktop app), a banner when a session changes state (with Allow and Deny when one asks), and how much of your Claude 5-hour and 7-day limits you have used.",
  "version": "4.0.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "banners": true,
  "tick": "5s",
  "replaces": [
    "claude-code",
    "claude-usage"
  ],
  "permissions": {
    "claude": true,
    "claude_answer": true,
    "processes": true,
    "titles": true,
    "programs": true,
    "net": [
      "api.anthropic.com",
      "console.anthropic.com"
    ],
    "open": [
      "https://claude.ai/oauth/authorize"
    ],
    "storage": true
  },
  "settings": {
    "alerts": {
      "label": "Banners when a session changes",
      "type": "toggle",
      "default": true
    },
    "b_start": {
      "label": "Banner: starts working",
      "type": "toggle",
      "default": true
    },
    "b_needs": {
      "label": "Banner: needs me",
      "type": "toggle",
      "default": true
    },
    "b_done": {
      "label": "Banner: done",
      "type": "toggle",
      "default": true
    },
    "b_stop": {
      "label": "Banner: stopped with errors",
      "type": "toggle",
      "default": true
    },
    "b_quiet": {
      "label": "Banner: gone quiet",
      "type": "toggle",
      "default": false
    },
    "b_open": {
      "label": "Banner: session opens or closes",
      "type": "toggle",
      "default": false
    },
    "skip": {
      "label": "No done banner for turns shorter than",
      "type": "choice",
      "default": 10,
      "options": [
        {
          "value": 0,
          "label": "Never skip"
        },
        {
          "value": 10,
          "label": "10 seconds"
        },
        {
          "value": 30,
          "label": "30 seconds"
        },
        {
          "value": 60,
          "label": "1 minute"
        }
      ]
    },
    "usage": {
      "label": "Show how much of my limits is used",
      "type": "toggle",
      "default": true
    },
    "replies": {
      "label": "Let me reply when a session finishes",
      "type": "toggle",
      "default": false
    },
    "wait": {
      "label": "How long to wait for my answer",
      "type": "choice",
      "default": 20,
      "options": [
        {
          "value": 10,
          "label": "10 seconds"
        },
        {
          "value": 20,
          "label": "20 seconds"
        },
        {
          "value": 30,
          "label": "30 seconds"
        },
        {
          "value": 60,
          "label": "1 minute"
        },
        {
          "value": 120,
          "label": "2 minutes"
        }
      ]
    }
  },
  "actions": [
    {
      "id": "usage_login",
      "label": "Sign In",
      "ask": "Paste the code the Claude page shows",
      "then": "usage_finish"
    },
    {
      "id": "answer_on",
      "label": "Set Up Answering"
    },
    {
      "id": "answer_off",
      "label": "Remove Answering"
    }
  ],
  "widgets": [
    {
      "id": "sessions",
      "name": "Claude Sessions",
      "description": "How your sessions stand, the one that needs you first",
      "place": "top",
      "rank": 39
    },
    {
      "id": "usage",
      "name": "Claude Usage",
      "description": "How much of your 5-hour and 7-day limits is used",
      "place": "right",
      "rank": 40
    }
  ]
}
