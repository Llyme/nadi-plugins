{
  "id": "ics-calendar",
  "name": "Calendar",
  "description": "The events of a calendar link (.ics: Google Calendar, Outlook, iCloud), the date and time, a month you open from it, and a banner shortly before an event.",
  "version": "5.0.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "banners": true,
  "tick": "30s",
  "budget": {
    "call_ms": 400,
    "memory_mb": 64
  },
  "permissions": {
    "net": [
      "{{settings.url}}"
    ]
  },
  "settings": {
    "url": {
      "label": "Calendar link (.ics)",
      "type": "text",
      "default": ""
    },
    "poll_min": {
      "label": "Look again every (minutes)",
      "type": "number",
      "default": 10
    },
    "h24": {
      "label": "24-hour clock",
      "type": "toggle",
      "default": false
    },
    "week_start": {
      "label": "Week starts on",
      "type": "choice",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Sunday"
        },
        {
          "value": 1,
          "label": "Monday"
        }
      ]
    },
    "remind": {
      "label": "Banner before an event",
      "type": "toggle",
      "default": true
    },
    "lead_min": {
      "label": "How long before (minutes)",
      "type": "number",
      "default": 15
    }
  },
  "widgets": [
    {
      "id": "calendar",
      "name": "Date and Time",
      "description": "The clock and the date; open, the month",
      "place": "top-right",
      "rank": 10
    }
  ]
}
