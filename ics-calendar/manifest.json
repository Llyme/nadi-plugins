{
  "id": "ics-calendar",
  "name": "Calendar",
  "description": "The events of a calendar link (.ics: Google Calendar, Outlook, iCloud), the date and time, a month you open from it, a banner shortly before an event, and, if you like, one that says the time now and then.",
  "version": "5.2.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "banners": true,
  "tick": "30s",
  "budget": {
    "call_ms": 400,
    "memory_mb": 64
  },
  "permissions": {
    "net": [
      "{{settings.url}}"
    ]
  },
  "settings": {
    "url": {
      "label": "Calendar link (.ics)",
      "type": "text",
      "default": ""
    },
    "poll_min": {
      "label": "Look again every (minutes)",
      "type": "number",
      "default": 10
    },
    "h24": {
      "label": "24-hour clock",
      "type": "toggle",
      "default": false
    },
    "chime": {
      "label": "Say the time",
      "type": "choice",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Never"
        },
        {
          "value": 15,
          "label": "Every 15 minutes"
        },
        {
          "value": 30,
          "label": "Every 30 minutes"
        },
        {
          "value": 60,
          "label": "Every hour"
        },
        {
          "value": 120,
          "label": "Every 2 hours"
        },
        {
          "value": 180,
          "label": "Every 3 hours"
        },
        {
          "value": 360,
          "label": "Every 6 hours"
        }
      ]
    },
    "week_start": {
      "label": "Week starts on",
      "type": "choice",
      "default": 0,
      "options": [
        {
          "value": 0,
          "label": "Sunday"
        },
        {
          "value": 1,
          "label": "Monday"
        }
      ]
    },
    "remind": {
      "label": "Banner before an event",
      "type": "toggle",
      "default": true
    },
    "lead_min": {
      "label": "How long before (minutes)",
      "type": "number",
      "default": 15
    }
  },
  "widgets": [
    {
      "id": "calendar",
      "name": "Date and Time",
      "description": "The clock and the date; open, the month",
      "place": "top-right",
      "rank": 10
    }
  ],
  "actions": [
    {
      "id": "say_time",
      "label": "Say the time now"
    }
  ]
}
