{
  "id": "toasts",
  "name": "Notification Mirror",
  "description": "Shows the notifications of other apps (Discord, Viber, ...) as banners. Pressing one opens the app.",
  "version": "3.0.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "banners": true,
  "permissions": {
    "notifications": true,
    "processes": true,
    "titles": true,
    "open": ["viber://", "discord://"]
  },
  "settings": {
    "viber": { "label": "Notice Viber's popup", "type": "toggle", "default": true }
  }
}
