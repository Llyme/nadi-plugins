{
  "id": "toasts",
  "name": "Notification mirror",
  "description": "Shows the notifications of other apps (Discord, Viber, ...) on the island.",
  "version": "2.0.0",
  "kind": "wasm",
  "module": "notification-mirror.wasm",
  "default_on": false,
  "banners": true,
  "permissions": {
    "notifications": true,
    "processes": true,
    "titles": true,
    "open": ["viber://", "discord://"]
  },
  "source": { "when": "always" },
  "settings": {
    "viber": { "label": "Notice Viber's popup", "type": "toggle", "default": true }
  }
}
