{
  "id": "page-reader",
  "name": "Page Reader",
  "description": "A section for each page you have open, with what the page says (needs the NADI browser extension).",
  "version": "3.1.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "permissions": {
    "processes": true,
    "titles": true,
    "programs": true,
    "browser": true
  },
  "budget": {
    "call_ms": 60,
    "memory_mb": 32
  },
  "settings": {
    "images": {
      "label": "Show the page's main picture",
      "type": "toggle",
      "default": true
    }
  },
  "widgets": [
    {
      "id": "pages",
      "name": "Pages",
      "description": "What you are reading",
      "place": "left",
      "rank": 40
    }
  ]
}
