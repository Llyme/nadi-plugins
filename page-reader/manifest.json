{
  "id": "page-reader",
  "name": "Page Reader",
  "description": "A card in the expanded island for each page you have open, with what the page says (needs the NADI browser extension).",
  "version": "2.0.0",
  "kind": "wasm",
  "module": "page-reader.wasm",
  "default_on": false,
  "permissions": {
    "processes": true,
    "titles": true,
    "programs": true,
    "browser": true
  },
  "source": { "when": "always" },
  "budget": { "call_ms": 20, "memory_mb": 32 },
  "settings": {
    "images": { "label": "Show the page's main picture", "type": "toggle", "default": true }
  }
}
