    "brightness": { "label": "Max brightness (0 = off)", "type": "range", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    "ambient": { "label": "Light outside the island", "type": "range", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 }
  }
}
