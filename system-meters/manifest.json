{
  "id": "system-meters",
  "name": "System Meters",
  "description": "How busy the CPU, the memory and the graphics card are: three thin bars, open a ring for each, and a banner when the processor stays busy.",
  "version": "3.1.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "permissions": {
    "system": true
  },
  "widgets": [
    {
      "id": "meters",
      "name": "System",
      "description": "CPU, memory and graphics card",
      "place": "right",
      "rank": 50
    }
  ],
  "banners": true,
  "settings": {
    "alert": {
      "label": "Banner when the processor stays busy",
      "type": "toggle",
      "default": true
    },
    "limit": {
      "label": "Busy above",
      "type": "range",
      "default": 90,
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%"
    }
  }
}
