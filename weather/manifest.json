{
  "id": "example-weather",
  "name": "Weather (Example)",
  "description": "The weather where you are, from open-meteo.com. Set your place below.",
  "version": "2.0.0",
  "kind": "luau",
  "main": "main.luau",
  "tick": "1m",
  "permissions": {
    "net": [
      "api.open-meteo.com"
    ]
  },
  "settings": {
    "latitude": {
      "label": "Latitude",
      "type": "number",
      "default": 25.03
    },
    "longitude": {
      "label": "Longitude",
      "type": "number",
      "default": 121.56
    }
  },
  "widgets": [
    {
      "id": "weather",
      "name": "Weather",
      "description": "The temperature now",
      "place": "top-left",
      "rank": 20
    }
  ]
}
