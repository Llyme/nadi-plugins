{
  "id": "work",
  "name": "Work",
  "description": "Time coded, as WakaTime counts it, kept on this PC: by project, language and file, with the pages you read for it, against a daily goal.",
  "version": "4.0.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "permissions": {
    "processes": true,
    "titles": true,
    "idle": true,
    "programs": true,
    "storage": true,
    "files": [
      "%APPDATA%/Code/User/globalStorage/storage.json",
      "%APPDATA%/Code - Insiders/User/globalStorage/storage.json",
      "%APPDATA%/Cursor/User/globalStorage/storage.json",
      "%APPDATA%/VSCodium/User/globalStorage/storage.json",
      "%APPDATA%/Windsurf/User/globalStorage/storage.json"
    ],
    "run": [
      "git -C * rev-parse --abbrev-ref HEAD",
      "git -C * diff --numstat --no-renames HEAD",
      "git -C * ls-files --others --exclude-standard"
    ]
  },
  "widgets": [
    {
      "id": "work",
      "name": "Work",
      "description": "Today's coding time against your goal",
      "place": "bottom",
      "rank": 30,
      "compact": true
    }
  ],
  "settings": {
    "goal_h": {
      "label": "Daily goal (hours)",
      "type": "number",
      "default": 4
    },
    "streak_days": {
      "label": "Days the streak counts",
      "type": "choice",
      "default": "weekdays",
      "options": [
        {
          "value": "weekdays",
          "label": "Weekdays"
        },
        {
          "value": "every",
          "label": "Every Day"
        }
      ]
    },
    "sites": {
      "label": "More sites that count as research (names, comma between)",
      "type": "text",
      "default": ""
    }
  }
}
