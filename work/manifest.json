{
  "id": "work",
  "name": "Work",
  "description": "What you work on: your editor, your hours, and a pill for the session you are in.",
  "version": "2.1.0",
  "kind": "wasm",
  "tile": {"name": "Work", "icon": "code", "tint": "#6d6d78", "sizes": ["small", "wide"], "idle": "not working"},
  "module": "work.wasm",
  "default_on": false,
  "permissions": {
    "processes": true,
    "titles": true,
    "idle": true,
    "programs": true,
    "storage": true,
    "files": [
      "%APPDATA%/Code/User/globalStorage/storage.json",
      "%APPDATA%/Code - Insiders/User/globalStorage/storage.json",
      "%APPDATA%/Cursor/User/globalStorage/storage.json",
      "%APPDATA%/VSCodium/User/globalStorage/storage.json",
      "%APPDATA%/Windsurf/User/globalStorage/storage.json"
    ],
    "run": [
      "git -C * rev-parse --abbrev-ref HEAD",
      "git -C * diff --numstat --no-renames HEAD",
      "git -C * ls-files --others --exclude-standard"
    ]
  },
  "source": {
    "when": "always"
  },
  "widgets": [
    {
      "id": "session",
      "name": "Session",
      "place": "left",
      "rank": 40,
      "width": 110,
      "start": false
    },
    {
      "id": "hours",
      "name": "Time in it",
      "place": "right",
      "rank": 41,
      "width": 56,
      "start": false
    }
  ],
  "rests": [
    {
      "id": "session",
      "name": "Work",
      "description": "What you are working on at the left, for how long at the right.",
      "when": "While you are in a work session",
      "priority": 30,
      "left": "session",
      "center": "",
      "right": "hours"
    }
  ]
}
