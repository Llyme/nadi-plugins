{
  "id": "work",
  "name": "Work",
  "description": "What you work on: your editor and its project, your hours, and the session you are in.",
  "version": "3.1.0",
  "kind": "luau",
  "main": "main.luau",
  "default_on": false,
  "permissions": {
    "processes": true,
    "titles": true,
    "idle": true,
    "programs": true,
    "storage": true,
    "files": [
      "%APPDATA%/Code/User/globalStorage/storage.json",
      "%APPDATA%/Code - Insiders/User/globalStorage/storage.json",
      "%APPDATA%/Cursor/User/globalStorage/storage.json",
      "%APPDATA%/VSCodium/User/globalStorage/storage.json",
      "%APPDATA%/Windsurf/User/globalStorage/storage.json"
    ],
    "run": [
      "git -C * rev-parse --abbrev-ref HEAD",
      "git -C * diff --numstat --no-renames HEAD",
      "git -C * ls-files --others --exclude-standard"
    ]
  },
  "widgets": [
    {
      "id": "work",
      "name": "Work",
      "description": "The session you are in, and for how long",
      "place": "bottom",
      "rank": 30,
      "compact": true
    }
  ]
}
